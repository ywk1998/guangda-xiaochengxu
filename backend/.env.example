# ============ 微信小程序（订阅消息推送 / 真实 openid） ============
# 小程序后台「开发管理 → 开发设置」里获取；AppSecret 只显示一次，请自行保存
WX_APPID=你的小程序AppID
WX_APPSECRET=你的小程序AppSecret

# 推送总开关：1=开启，其它值=关闭（关闭时只保留站内消息）
WX_PUSH_ENABLED=0

# 订阅消息模板 ID（小程序后台「订阅消息 → 我的模板」里复制）
WX_TMPL_APPROVAL_RESULT=审批结果通知模板ID
WX_TMPL_APPROVAL_PENDING=待审批提醒模板ID

# 可选：模板字段编号映射（默认 thing1/thing2/time3/thing4，按你选的模板调整）
# WX_TMPL_RESULT_KEYS={"title":"thing1","result":"thing2","time":"time3","remark":"thing4"}
# WX_TMPL_PENDING_KEYS={"title":"thing1","submitter":"thing2","form":"thing3","time":"time4"}
