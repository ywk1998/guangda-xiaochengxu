.approval-selector {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.selector-nav {
  height: 112rpx;
  padding: env(safe-area-inset-top) 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1a6fc4;
  color: #fff;
  box-sizing: content-box;
}

.selector-nav-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 58rpx;
  font-weight: 300;
}

.selector-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.selector-search {
  height: 88rpx;
  margin: 20rpx 24rpx 0;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.selector-search-icon {
  margin-right: 14rpx;
  color: #c7c7c7;
  font-size: 42rpx;
}

.selector-search-input {
  flex: 1;
  color: #333;
  font-size: 30rpx;
}

.selector-tab {
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 12rpx;
  border-bottom: 4rpx solid #1a6fc4;
  color: #333;
  font-size: 30rpx;
  text-align: center;
}

.selector-scroll {
  flex: 1;
  min-height: 0;
  background: #fff;
}

.selector-user {
  height: 122rpx;
  padding: 0 0 0 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.selector-avatar {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #eaf3ff;
  color: #1a6fc4;
  font-size: 26rpx;
  text-align: center;
}

.selector-name {
  flex: 1;
  min-width: 0;
  color: #222;
  font-size: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-check {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  margin: 0 28rpx 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 4rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.selector-check.active {
  border-color: #1a6fc4;
  background: #1a6fc4;
}

.selector-empty {
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}

.selector-footer {
  min-height: 112rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

.selector-count {
  flex: 1;
  color: #666;
  font-size: 28rpx;
}

.selector-confirm {
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 8rpx;
  background: #1a6fc4;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
}

.selector-confirm::after {
  border: none;
}
