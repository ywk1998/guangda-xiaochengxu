/* pages/contact/contact.wxss - 联系页高级感升级版 */

.page-contact {
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #eef1f7 100%);
}

/* ===== Hero 升级 ===== */
.contact-hero {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 50%, #7eb5ff 100%);
  padding: 80rpx 32rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.contact-hero::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.contact-hero::after {
  content: '';
  position: absolute;
  bottom: -60rpx;
  left: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

/* 装饰圆点 */
.hero-decoration {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
}

.hero-decoration:nth-child(1) { top: 40rpx; left: 60rpx; }
.hero-decoration:nth-child(2) { top: 80rpx; right: 80rpx; width: 8rpx; height: 8rpx; }
.hero-decoration:nth-child(3) { bottom: 100rpx; right: 40rpx; width: 16rpx; height: 16rpx; }

.contact-hero-icon {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 28rpx;
  border-radius: 36rpx;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  position: relative;
  z-index: 1;
}

.contact-hero-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  margin-bottom: 14rpx;
  letter-spacing: -0.5rpx;
  position: relative;
  z-index: 1;
}

.contact-hero-sub {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  position: relative;
  z-index: 1;
}

/* ===== 联系卡片升级 ===== */
.contact-cards {
  margin-top: 24rpx;
  padding: 0 32rpx;
  position: relative;
  z-index: 10;
}

.contact-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  transition: var(--transition-smooth);
  position: relative;
  overflow: hidden;
}

.contact-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}

.contact-card:active {
  transform: scale(0.98);
}

.cc-left {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.cc-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 42rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.1);
}

.cc-phone  { background: linear-gradient(135deg, #fef3f0, #fff5f2); }
.cc-email  { background: linear-gradient(135deg, rgba(26, 92, 240, 0.1), rgba(74, 138, 255, 0.15)); }
.cc-time   { background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(74, 222, 128, 0.15)); }
.cc-wechat { background: linear-gradient(135deg, rgba(34, 197, 94, 0.1), rgba(74, 222, 128, 0.15)); }

.cc-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex: 1;
}

.cc-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.cc-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  letter-spacing: -0.3rpx;
}

.cc-actions {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.cc-btn {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
  transition: var(--transition-bounce);
}

.cc-btn:active {
  transform: scale(0.95);
}

.cc-btn-call {
  background: var(--primary-gradient);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx var(--primary-glow);
}

.cc-btn-copy {
  background: linear-gradient(135deg, rgba(26, 92, 240, 0.08), rgba(74, 138, 255, 0.12));
  color: var(--primary);
  border: 1rpx solid rgba(26, 92, 240, 0.15);
}

/* ===== 地图升级 ===== */
.map-wrap {
  padding: 0 !important;
  overflow: hidden;
  border-radius: var(--radius-lg);
  margin: 0 32rpx 20rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
}

.map {
  width: 100%;
  height: 380rpx;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.map-address {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: var(--bg-card);
  border-top: 1rpx solid var(--border-light);
}

.map-addr-icon {
  font-size: 36rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.map-addr-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.map-nav-btn {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 700;
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, rgba(26, 92, 240, 0.08), rgba(74, 138, 255, 0.12));
  border-radius: 30rpx;
  border: 1rpx solid rgba(26, 92, 240, 0.15);
}

/* ===== 留言表单升级 ===== */
.form-card {
  padding: 0 !important;
  border-radius: var(--radius-lg);
  margin: 0 32rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  overflow: hidden;
  background: var(--bg-card);
}

.form-item {
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--border-light);
  position: relative;
  transition: var(--transition-fast);
}

.form-item:last-child {
  border-bottom: none;
}

.form-item:focus-within {
  background: var(--bg-subtle);
}

.form-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.form-required {
  color: #ef4444;
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  font-size: 30rpx;
  color: var(--text-primary);
  height: 48rpx;
  line-height: 48rpx;
  background: transparent;
}

.form-input::placeholder {
  color: var(--text-light);
}

.form-textarea {
  width: 100%;
  font-size: 30rpx;
  color: var(--text-primary);
  min-height: 160rpx;
  line-height: 1.7;
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  transition: var(--transition-smooth);
}

.form-textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 4rpx var(--primary-glow);
  background: var(--bg-card);
}

.form-count {
  font-size: 22rpx;
  color: var(--text-light);
  position: absolute;
  right: 32rpx;
  bottom: 28rpx;
}

.submit-btn {
  display: block;
  margin: 32rpx;
  background: var(--primary-gradient);
  color: #ffffff;
  border-radius: var(--radius-xl);
  font-size: 32rpx;
  font-weight: 700;
  height: 100rpx;
  line-height: 100rpx;
  box-shadow: var(--shadow-glow);
  border: none;
  position: relative;
  overflow: hidden;
  letter-spacing: 2rpx;
}

.submit-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s ease;
}

.submit-btn:active::before {
  left: 100%;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.98);
}

.btn-disabled {
  opacity: 0.6;
  box-shadow: none;
}

/* ===== 提交成功升级 ===== */
.submit-success {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 32rpx;
}

.ss-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  animation: successBounce 0.6s ease-out;
}

@keyframes successBounce {
  0% { transform: scale(0); opacity: 0; }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); opacity: 1; }
}

.ss-title {
  font-size: 40rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #10b981, #34d399);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 18rpx;
}

.ss-desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
}
