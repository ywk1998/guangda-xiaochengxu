/* pages/approval-list/approval-list.wxss */

.page {
  min-height: 100vh;
  background: #f5f7fb;
}

.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.filter-pill {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  background: #e6f3ff;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #1a6fc4;
}

.filter-pill.muted {
  background: #f1f5f9;
  color: #64748b;
}

.arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
}

.stat-bar {
  padding: 16rpx 24rpx;
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notify-btn {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #fff;
  background: #1a6fc4;
  border-radius: 24rpx;
}

.stat-text {
  font-size: 24rpx;
  color: #999;
}

.record-list {
  box-sizing: border-box;
  height: calc(100vh - 220rpx);
  padding: 16rpx 24rpx;
}

.record-card {
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  min-width: 0;
  flex: 1;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-tag.pending {
  background: #fff7e6;
  color: #e67e22;
}

.status-tag.approved {
  background: #e8f8f0;
  color: #27ae60;
}

.status-tag.rejected {
  background: #fef0f0;
  color: #e74c3c;
}

.status-tag.deleted {
  background: #f1f5f9;
  color: #64748b;
}

.card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  padding: 10rpx 0;
}

.card-row-time {
  padding-top: 14rpx;
  margin-top: 6rpx;
  border-top: 1rpx dashed #eee;
}

.row-label {
  width: 180rpx;
  flex-shrink: 0;
  color: #999;
  font-size: 26rpx;
}

.row-value {
  min-width: 0;
  flex: 1;
  color: #333;
  font-size: 28rpx;
  text-align: right;
  overflow-wrap: break-word;
  word-break: break-all;
}

.approval-selector {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.selector-nav {
  height: 112rpx;
  padding: env(safe-area-inset-top) 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1a6fc4;
  color: #fff;
  box-sizing: content-box;
}

.selector-nav-btn {
  width: 72rpx;
  height: 72rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 58rpx;
  font-weight: 300;
}

.selector-title {
  flex: 1;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
}

.selector-search {
  height: 88rpx;
  margin: 20rpx 24rpx 0;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 8rpx;
  background: #f5f5f5;
}

.selector-search-icon {
  margin-right: 14rpx;
  color: #c7c7c7;
  font-size: 42rpx;
}

.selector-search-input {
  flex: 1;
  color: #333;
  font-size: 30rpx;
}

.selector-tab {
  height: 92rpx;
  line-height: 92rpx;
  margin-top: 12rpx;
  border-bottom: 4rpx solid #1a6fc4;
  color: #333;
  font-size: 30rpx;
  text-align: center;
}

.selector-scroll {
  flex: 1;
  min-height: 0;
  background: #fff;
}

.selector-user {
  height: 122rpx;
  padding: 0 0 0 32rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.selector-avatar {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: #fff6d9;
  color: #9a741c;
  font-size: 26rpx;
  text-align: center;
}

.selector-name {
  flex: 1;
  min-width: 0;
  color: #222;
  font-size: 30rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.selector-check {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  margin: 0 4rpx 0 24rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 4rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.selector-check.active {
  border-color: #1a6fc4;
  background: #1a6fc4;
}

.selector-empty {
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
  text-align: center;
}

.selector-footer {
  height: 104rpx;
  padding: 12rpx 10rpx 12rpx 32rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  border-top: 1rpx solid #eee;
  background: #fff;
}

.selector-count {
  flex: 1;
  color: #1a6fc4;
  font-size: 28rpx;
}

.selector-confirm {
  width: 160rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  border-radius: 6rpx;
  background: #1a6fc4;
  color: #fff;
  font-size: 30rpx;
}

.row-value.highlight {
  color: #1a6fc4;
  font-weight: 600;
}

.row-value.time {
  color: #bbb;
  font-size: 24rpx;
}

.detail-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 64rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #f3f8ff;
  color: #1a6fc4;
  font-size: 26rpx;
  font-weight: 700;
}

.detail-arrow {
  font-size: 18rpx;
}

.detail-panel {
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #edf2f7;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed #e5e7eb;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  width: 180rpx;
  flex-shrink: 0;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-value {
  min-width: 0;
  flex: 1;
  color: #1f2937;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: right;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-image {
  flex-shrink: 0;
  width: 148rpx;
  height: 148rpx;
  border-radius: 10rpx;
  background: #eef2f7;
}

.detail-image.small {
  width: 128rpx;
  height: 128rpx;
}

.detail-image-list {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx;
}

.detail-image-list.small {
  max-width: 430rpx;
}

.detail-block {
  padding: 14rpx 0;
  border-bottom: 1rpx dashed #e5e7eb;
}

.detail-block:last-child {
  border-bottom: none;
}

.block-label {
  display: block;
  width: auto;
  margin-bottom: 10rpx;
}

.detail-subcard {
  padding: 14rpx;
  margin-bottom: 10rpx;
  border-radius: 10rpx;
  background: #fff;
  border: 1rpx solid #eef2f7;
}

.detail-subcard:last-child {
  margin-bottom: 0;
}

.detail-subtitle {
  display: block;
  margin-bottom: 6rpx;
  color: #1a6fc4;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-subtext {
  display: block;
  color: #374151;
  font-size: 24rpx;
  line-height: 1.55;
  white-space: pre-wrap;
  word-break: break-all;
}

.detail-subrow {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 8rpx 0;
  border-top: 1rpx dashed #e5e7eb;
}

.detail-subrow:first-of-type {
  border-top: 0;
}

.detail-sub-label {
  flex-shrink: 0;
  color: #64748b;
  font-size: 24rpx;
}

.detail-sub-value {
  min-width: 0;
  flex: 1;
  color: #374151;
  font-size: 24rpx;
  text-align: right;
  word-break: break-all;
}

.approval-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 22rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
}

.action-btn::after {
  border: none;
}

.action-btn.approve {
  background: #1a6fc4;
  color: #fff;
}

.action-btn.reject {
  background: #fef0f0;
  color: #e74c3c;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
  font-size: 28rpx;
}

.loading-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #ccc;
  font-size: 24rpx;
}
