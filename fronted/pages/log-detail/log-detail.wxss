/* pages/log-detail/log-detail.wxss - 日志详情高级感升级版 */

.page-detail {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #eef1f7 100%);
}

.loading-full {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  color: var(--text-muted);
  font-size: 28rpx;
}

/* 顶部升级 */
.detail-header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 50%, #7eb5ff 100%);
  padding: 48rpx 32rpx 36rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.detail-header::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.detail-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  position: relative;
  z-index: 1;
}

.detail-project {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 18rpx;
  letter-spacing: -0.3rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.detail-status {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 30rpx;
  flex-shrink: 0;
  font-weight: 600;
}

.status-submitted {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
  backdrop-filter: blur(10rpx);
}

.status-draft {
  background: rgba(255, 255, 255, 0.15);
  color: rgba(255, 255, 255, 0.9);
}

.detail-submit-time {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
  position: relative;
  z-index: 1;
}

/* 卡片升级 */
.section-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  margin: 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  position: relative;
  overflow: hidden;
}

.section-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
}

/* 标题栏升级 */
.detail-title-bar {
  display: flex;
  align-items: center;
  margin-bottom: 22rpx;
}

.title-dot {
  width: 6rpx;
  height: 32rpx;
  background: var(--primary-gradient);
  border-radius: 3rpx;
  margin-right: 14rpx;
  box-shadow: 0 4rpx 12rpx var(--primary-glow);
}

.detail-title-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.3rpx;
}

/* 行升级 */
.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 76rpx;
}

.detail-label {
  font-size: 26rpx;
  color: var(--text-muted);
  flex-shrink: 0;
  font-weight: 500;
}

.detail-value {
  font-size: 28rpx;
  color: var(--text-primary);
  text-align: right;
  flex: 1;
  margin-left: 24rpx;
  word-break: break-all;
  font-weight: 500;
}

.detail-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--border-color), transparent);
}

/* 网格数据升级 */
.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 10rpx;
}

.detail-grid-item {
  width: 48%;
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
  padding: 18rpx 22rpx;
  border: 1rpx solid var(--border-light);
}

.grid-label {
  font-size: 22rpx;
  color: var(--text-muted);
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.grid-value {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 700;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* 表格升级 */
.detail-table {
  margin-top: 10rpx;
}

/* 施工内容表格横向滚动 */
.dt-scroll {
  width: 100%;
  white-space: nowrap;
}

.dt-inner-wide {
  display: inline-block;
  white-space: normal;
  width: 1240rpx;
}

.dt-inner-narrow {
  display: inline-block;
  white-space: normal;
  width: 900rpx;
}

/* 空数据占位提示 */
.detail-empty {
  padding: 16rpx 0 4rpx;
  font-size: 24rpx;
  color: #c0c4cc;
}

/* 表格下方说明文字 */
.detail-note {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  background: var(--bg-subtle, #f7f8fa);
  border-left: 4rpx solid var(--primary, #1a5cf0);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary, #606266);
  line-height: 1.6;
  word-break: break-all;
}

.detail-subsection {
  margin-bottom: 24rpx;
}

.detail-subsection-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 700;
}

.dt-header {
  display: flex;
  background: linear-gradient(135deg, rgba(26, 92, 240, 0.06), rgba(74, 138, 255, 0.1));
  padding: 16rpx 18rpx;
  border-radius: var(--radius-md);
  margin-bottom: 10rpx;
}

.dt-th {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 700;
  text-align: center;
}

.dt-row {
  display: flex;
  padding: 16rpx 18rpx;
  border-bottom: 1rpx solid var(--border-light);
  transition: var(--transition-fast);
}

.dt-row:last-child {
  border-bottom: none;
}

.dt-td {
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  font-weight: 500;
}

.detail-thumb {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: var(--bg-subtle);
}

/* 施工照片 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 0 16rpx;
}

.photo-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  background: var(--bg-subtle);
}

/* 附件列表 */
.attach-list {
  padding: 4rpx 0 8rpx;
}

.attach-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-light, #eef0f5);
}

.attach-main {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.attach-icon {
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  background: #eaf3ff;
  color: #2f6fd0;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.attach-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.attach-name {
  font-size: 26rpx;
  color: var(--text-primary, #303133);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.attach-size {
  font-size: 22rpx;
  color: var(--text-secondary, #909399);
  margin-top: 6rpx;
}

/* 备注升级 */
.detail-remark {
  margin-top: 18rpx;
  background: var(--bg-subtle);
  border-radius: var(--radius-md);
  padding: 18rpx 22rpx;
  border-left: 4rpx solid var(--primary);
}

.remark-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.remark-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
}

.detail-block-text {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.8;
}

/* 删除升级 */
.delete-area {
  padding: 32rpx;
  padding-bottom: 60rpx;
}

.btn-edit {
  text-align: center;
  font-size: 28rpx;
  color: #1a6fc4;
  padding: 26rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(26, 111, 196, 0.28);
  border-radius: var(--radius-xl);
  background: rgba(26, 111, 196, 0.06);
  transition: var(--transition-bounce);
}

.btn-edit:active {
  transform: scale(0.98);
  background: rgba(26, 111, 196, 0.12);
}

.btn-copy {
  text-align: center;
  font-size: 28rpx;
  color: #0e7490;
  padding: 26rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(14, 116, 144, 0.28);
  border-radius: var(--radius-xl);
  background: rgba(14, 116, 144, 0.06);
  transition: var(--transition-bounce);
}

.btn-copy:active {
  transform: scale(0.98);
  background: rgba(14, 116, 144, 0.12);
}

.btn-delete {
  text-align: center;
  font-size: 28rpx;
  color: #ef4444;
  padding: 26rpx;
  border: 2rpx solid rgba(239, 68, 68, 0.3);
  border-radius: var(--radius-xl);
  background: rgba(239, 68, 68, 0.05);
  transition: var(--transition-bounce);
}

.btn-delete:active {
  transform: scale(0.98);
  background: rgba(239, 68, 68, 0.1);
}

.approval-record-section {
  margin: 24rpx;
}
