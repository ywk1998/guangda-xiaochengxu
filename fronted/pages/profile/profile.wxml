<!-- pages/profile/profile.wxml - 个人中心 -->
<view class="page-profile">

  <scroll-view scroll-y class="scroll-content" show-scrollbar="{{false}}">

    <!-- ===== 用户信息卡 ===== -->
    <view class="user-card">
      <!-- 背景装饰 -->
      <view class="user-card-bg"></view>

      <!-- 已登录 -->
      <block wx:if="{{isLogin && userInfo}}">
        <view class="user-info">
          <image
            class="user-avatar"
            src="{{userInfo.avatarUrl || 'https://via.placeholder.com/120/1a6fc4/ffffff?text=用户'}}"
            mode="aspectFill"
          />
          <view class="user-detail">
            <text class="user-name">{{userInfo.nickName || '用户'}}</text>
            <view class="role-badge {{roleMeta.className}}">{{roleMeta.label}}</view>
          </view>
          <view class="user-edit-btn" bindtap="onLogout">
            <text class="user-edit-text">退出</text>
          </view>
        </view>
      </block>

      <!-- 未登录 -->
      <block wx:else>
        <view class="guest-info">
          <view class="guest-avatar">👤</view>
          <view class="guest-detail">
            <text class="guest-title">您好，欢迎使用</text>
            <text class="guest-sub">登录后享受完整服务体验</text>
          </view>
        </view>
        <button class="login-btn" bindtap="onLogin">账号密码登录</button>
      </block>
    </view>

    <!-- ===== 功能菜单 ===== -->
    <view class="menu-groups px-30 {{isLogin ? 'mt-24' : 'mt-neg-small'}}">
      <view wx:for="{{menuList}}" wx:key="group" class="menu-group">
        <text class="menu-group-title">{{item.group}}</text>
        <view class="menu-list card">
          <view
            wx:for="{{item.items}}"
            wx:key="id"
            wx:for-item="menu"
            class="menu-item {{index < item.items.length - 1 ? 'border-bottom' : ''}}"
            bindtap="onMenuTap"
            data-id="{{menu.id}}"
          >
            <view class="menu-item-left">
              <text class="menu-icon">{{menu.icon}}</text>
              <text class="menu-label">{{menu.label}}</text>
            </view>
            <view class="menu-item-right">
              <view wx:if="{{menu.dot}}" class="menu-dot"></view>
              <view wx:elif="{{menu.badge}}" class="menu-badge">{{menu.badge}}</view>
              <text class="menu-arrow">›</text>
            </view>
          </view>
        </view>
      </view>
    </view>

  </scroll-view>

  <!-- ===== 底部版本信息 ===== -->
  <view class="version-info">
    <text class="version-text">广东远大集团</text>
  </view>

  <view wx:if="{{showAuthPanel}}" class="auth-mask" catchtap="onCancelAuth">
    <view class="auth-sheet" catchtap="noop">
      <text class="auth-title">{{authTitle}}</text>
      <text class="auth-subtitle">{{authSubtitle}}</text>

      <view class="auth-form">
        <input class="auth-input" value="{{loginForm.name}}" placeholder="请输入姓名" data-field="name" bindinput="onAuthInput" />
        <input class="auth-input" password value="{{loginForm.password}}" placeholder="{{authMode === 'reset' ? '请输入新密码' : '请输入密码'}}" data-field="password" bindinput="onAuthInput" />
        <input wx:if="{{authMode !== 'login'}}" class="auth-input" password value="{{loginForm.confirmPassword}}" placeholder="请再次输入密码" data-field="confirmPassword" bindinput="onAuthInput" />
      </view>

      <view class="auth-links">
        <text wx:if="{{authMode !== 'login'}}" class="auth-link" bindtap="onShowLogin">返回登录</text>
        <text wx:if="{{authMode === 'login'}}" class="auth-link" bindtap="onShowRegister">注册账号</text>
        <text wx:if="{{authMode === 'login'}}" class="auth-link" bindtap="onShowReset">忘记密码</text>
      </view>

      <view class="auth-actions">
        <button class="auth-btn secondary" bindtap="onCancelAuth">取消</button>
        <button class="auth-btn primary" bindtap="onConfirmLogin">{{authMode === 'register' ? '注册并登录' : (authMode === 'reset' ? '重置密码' : '登录')}}</button>
      </view>
    </view>
  </view>

</view>
