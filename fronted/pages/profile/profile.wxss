/* pages/profile/profile.wxss - 个人中心高级感升级版 */

.page-profile {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f8f9fc 0%, #eef1f7 100%);
}

.scroll-content {
  flex: 1;
  height: 0;
}

/* ===== 用户信息卡升级 ===== */
.user-card {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 50%, #6fa3ff 100%);
  padding: 80rpx 32rpx 100rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.user-card-bg {
  position: absolute;
  top: -100rpx;
  right: -80rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.user-card-bg::after {
  content: '';
  position: absolute;
  top: 100rpx;
  left: 80rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
}

/* 装饰圆点 */
.user-card-dots {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

.user-dot {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
}

.user-dot:nth-child(1) { width: 16rpx; height: 16rpx; top: 60rpx; left: 40rpx; }
.user-dot:nth-child(2) { width: 10rpx; height: 10rpx; top: 120rpx; right: 60rpx; }
.user-dot:nth-child(3) { width: 20rpx; height: 20rpx; bottom: 140rpx; right: 100rpx; }

/* 已登录状态升级 */
.user-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.user-avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  background: rgba(255, 255, 255, 0.2);
}

.user-detail {
  flex: 1;
  margin-left: 28rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 130rpx;
}

.user-name {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.user-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.2;
}

.role-badge.admin {
  color: #7a4a00;
  background: linear-gradient(135deg, #fff3bf, #f4c542);
  border: 1rpx solid rgba(180, 119, 0, 0.28);
}

.role-badge.normal {
  color: #64748b;
  background: rgba(241, 245, 249, 0.95);
  border: 1rpx solid rgba(148, 163, 184, 0.28);
}

.user-edit-btn {
  padding: 14rpx 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 30rpx;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  transition: var(--transition-bounce);
}

.user-edit-btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.25);
}

.user-edit-text {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 未登录状态升级 */
.guest-info {
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 1;
}

.guest-avatar {
  font-size: 80rpx;
  width: 130rpx;
  height: 130rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
}

.guest-detail {
  margin-left: 28rpx;
}

.guest-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: -0.5rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.guest-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.login-btn {
  display: block;
  background: #ffffff;
  color: var(--primary);
  border-radius: var(--radius-xl);
  font-size: 32rpx;
  font-weight: 800;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  border: none;
  position: relative;
  z-index: 1;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  letter-spacing: 2rpx;
  transition: var(--transition-bounce);
}

.login-btn::after { border: none; }

.login-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.auth-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.46);
}

.auth-sheet {
  width: 100%;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.auth-title {
  display: block;
  color: var(--text-primary);
  font-size: 36rpx;
  font-weight: 800;
  text-align: center;
}

.auth-subtitle {
  display: block;
  margin-top: 12rpx;
  color: var(--text-muted);
  font-size: 26rpx;
  text-align: center;
}

.auth-btn::after {
  border: none;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 32rpx;
}

.auth-input {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f7fb;
  color: var(--text-primary);
  font-size: 30rpx;
  box-sizing: border-box;
}

.auth-links {
  display: flex;
  justify-content: space-between;
  min-height: 36rpx;
  margin-top: 20rpx;
}

.auth-link {
  color: var(--primary);
  font-size: 26rpx;
  font-weight: 700;
}

.auth-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.auth-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.auth-btn.secondary {
  background: #f2f4f7;
  color: var(--text-secondary);
}

.auth-btn.primary {
  background: var(--primary);
  color: #fff;
}

/* ===== 统计卡片升级 ===== */
.mx-30 { margin-left: 32rpx; margin-right: 32rpx; }
.mt-neg { margin-top: -50rpx; position: relative; z-index: 10; }
.mt-neg-small { margin-top: 28rpx; }

.stat-row {
  display: flex;
  padding: 0 !important;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-md);
  border: 1rpx solid var(--border-light);
  overflow: hidden;
}

.us-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 0;
  position: relative;
  transition: var(--transition-fast);
}

.us-item:active {
  background: var(--bg-subtle);
}

.us-num {
  font-size: 52rpx;
  font-weight: 800;
  background: var(--primary-gradient);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1;
  margin-bottom: 10rpx;
  letter-spacing: -1rpx;
}

.us-label {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
}

.us-divider {
  width: 1rpx;
  background: var(--border-light);
  margin: 24rpx 0;
}

/* ===== 功能菜单升级 ===== */
.menu-groups {
  padding-bottom: 50rpx;
}

.menu-group {
  margin-bottom: 28rpx;
}

.menu-group-title {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 700;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
  text-transform: uppercase;
}

.menu-list {
  padding: 0 !important;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background: var(--bg-card);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border-light);
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 32rpx;
  position: relative;
  transition: var(--transition-fast);
}

.menu-item::before {
  content: '';
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 0;
  height: 1rpx;
  background: var(--border-light);
}

.menu-item:last-child::before {
  display: none;
}

.menu-item:active {
  background: var(--bg-subtle);
}

.menu-item-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
  width: 52rpx;
  text-align: center;
}

.menu-label {
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: -0.3rpx;
}

.menu-item-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #ef4444, #f87171);
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.3);
  font-weight: 700;
}

.menu-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #ef4444;
  box-shadow: 0 0 0 4rpx rgba(239, 68, 68, 0.12);
}

.menu-arrow {
  font-size: 36rpx;
  color: var(--text-light);
  line-height: 1;
  transition: var(--transition-smooth);
}

.menu-item:active .menu-arrow {
  color: var(--primary);
  transform: translateX(4rpx);
}

/* ===== 版本信息升级 ===== */
.version-info {
  text-align: center;
  padding: 24rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: #eef1f7;
}

.version-text {
  font-size: 24rpx;
  color: var(--text-light);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.version-text::before,
.version-text::after {
  content: '';
  width: 60rpx;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--border-color));
}

.version-text::after {
  background: linear-gradient(90deg, var(--border-color), transparent);
}
