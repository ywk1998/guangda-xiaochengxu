/* pages/price-board/price-board.wxss - 今日挂牌价*/

.page-price {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* ===== 顶部标题 ===== */
.page-header {
  background: #1a6fc4;
  padding: 30rpx 32rpx;
  text-align: center;
  flex-shrink: 0;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
}

.header-date {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

/* ===== 两栏布局 ===== */
.content-wrapper {
  flex: 1;
  display: flex;
  overflow: hidden;
}

/* ===== 左侧导航 ===== */
.left-nav {
  width: 180rpx;
  background: #ffffff;
  border-right: 1rpx solid #e8eaf0;
  flex-shrink: 0;
}

.nav-item {
  padding: 40rpx 20rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.2s;
}

.nav-item.active {
  background: #f0f7ff;
  border-left: 6rpx solid #1a6fc4;
}

.nav-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.nav-item.active .nav-text {
  color: #1a6fc4;
  font-weight: 600;
}

/* ===== 右侧内容 ===== */
.right-content {
  flex: 1;
  padding: 24rpx;
}

.station-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
}

.station-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a6fc4;
}

.station-date {
  font-size: 24rpx;
  color: #999;
}

/* ===== 表头 ===== */
.price-header {
  display: flex;
  padding: 20rpx 24rpx;
  background: #f8f9fc;
  border-radius: 12rpx 12rpx 0 0;
  border: 1rpx solid #e8eaf0;
  border-bottom: none;
}

.price-header .col-product {
  flex: 2;
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
}

.price-header .col-price {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

/* ===== 价格列表 ===== */
.price-list {
  background: #ffffff;
  border-radius: 0 0 12rpx 12rpx;
  border: 1rpx solid #e8eaf0;
  border-top: none;
  overflow: hidden;
}

.price-item {
  display: flex;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.price-item:last-child {
  border-bottom: none;
}

.col-product {
  flex: 2;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.col-price {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: center;
  line-height: 40rpx;
  white-space: nowrap;
  padding: 0 16rpx;
}
