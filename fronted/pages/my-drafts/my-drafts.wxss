/* pages/my-drafts/my-drafts.wxss */

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.filter-pill {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 20rpx;
  background: #e6f3ff;
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #1a6fc4;
}

.filter-pill .arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
}

/* 统计栏 */
.stat-bar {
  padding: 16rpx 24rpx;
  background: #fafafa;
}

.stat-text {
  font-size: 24rpx;
  color: #999;
}

/* 草稿容器 */
.draft-container {
  box-sizing: border-box;
  height: calc(100vh - 220rpx);
  padding: 16rpx 24rpx;
}

/* 草稿卡片 */
.draft-card {
  box-sizing: border-box;
  max-width: 100%;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-tag {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  background: #fff3e0;
  color: #ff9800;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 行 */
.card-row {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.card-row-time {
  padding-top: 14rpx;
  margin-top: 6rpx;
  border-top: 1rpx dashed #eee;
}

.row-label {
  font-size: 26rpx;
  color: #999;
  width: 220rpx;
  flex-shrink: 0;
}

.row-value {
  min-width: 0;
  max-width: 420rpx;
  padding-right: 6rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
  text-align: right;
  flex: 1;
  overflow-wrap: break-word;
  word-break: break-all;
}

.row-value.highlight {
  color: #1a6fc4;
  font-weight: 600;
}

.row-value.time {
  font-size: 24rpx;
  color: #bbb;
}

/* 操作按钮 */
.action-bar {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-delete {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #999;
}

.btn-continue {
  flex: 2;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #1a6fc4;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #fff;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
  font-size: 28rpx;
}
