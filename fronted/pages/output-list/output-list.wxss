/* pages/output-list/output-list.wxss - 拌站出料表样式 */
.page-index {
  height: 100vh;
  background: #f5f5f5;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 30rpx;
  padding: 40rpx;
  background: linear-gradient(135deg, #1a6fc4 0%, #4a90e2 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 111, 196, 0.3);
}

.stats-card.single {
  justify-content: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
}

.stat-value.danger {
  color: #ff6b6b;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  margin: 0 30rpx 20rpx;
  gap: 20rpx;
}

.filter-item {
  flex: 1;
}

.filter-input {
  height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 36rpx;
  font-size: 26rpx;
}

.filter-btn {
  height: 72rpx;
  padding: 0 30rpx;
  background: linear-gradient(135deg, #1a6fc4 0%, #4a90e2 100%);
  border-radius: 36rpx;
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-btn.approval {
  background: #fff;
  color: #1a6fc4;
  border: 2rpx solid #1a6fc4;
}

/* 记录列表 */
.record-list {
  box-sizing: border-box;
  height: calc(100vh - 350rpx);
  padding: 0 30rpx;
}

.record-card {
  box-sizing: border-box;
  max-width: 100%;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-bottom: 1rpx solid #eee;
}

.record-date {
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-category {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  background: #e3f2fd;
  color: #1a6fc4;
  border-radius: 20rpx;
}

.record-badges {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.approval-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.approval-tag.pending {
  background: #fff7e6;
  color: #e67e22;
}

.approval-tag.approved {
  background: #e8f8f0;
  color: #27ae60;
}

.approval-tag.rejected {
  background: #fef0f0;
  color: #e74c3c;
}

.approval-tag.deleted {
  background: #f1f5f9;
  color: #64748b;
}

.record-body {
  padding: 16rpx 24rpx;
}

.record-row {
  min-width: 0;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-row:last-child {
  border-bottom: none;
}

.record-row.primary {
  background: #f8f9fa;
  margin: 0 -24rpx;
  padding: 16rpx 24rpx;
}

.record-label {
  font-size: 26rpx;
  color: #666;
  min-width: 160rpx;
  flex-shrink: 0;
}

.record-value {
  min-width: 0;
  max-width: 420rpx;
  padding: 0 6rpx 0 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
  word-break: break-all;
}

.record-value.highlight {
  color: #1a6fc4;
  font-size: 32rpx;
  font-weight: bold;
}

.record-value.success {
  color: #27ae60;
}

.record-value.danger {
  color: #e74c3c;
}

.record-footer {
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  justify-content: flex-end;
}

.delete-btn {
  font-size: 24rpx;
  color: #e74c3c;
  padding: 8rpx 20rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #999;
}

.empty-hint {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 16rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-content.center {
  width: 80%;
  max-height: 60vh;
  border-radius: 24rpx;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 40rpx;
  color: #999;
  padding: 10rpx;
}

.modal-body {
  flex: 1;
  padding: 20rpx 30rpx;
  max-height: 60vh;
}

.modal-body.center {
  max-height: none;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.form-section-title {
  margin: 4rpx 0 18rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1a6fc4;
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.form-input {
  box-sizing: border-box;
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.picker-input {
  display: flex;
  align-items: center;
}

.picker-input.placeholder {
  color: #999;
}

.form-textarea {
  width: 100%;
  height: 120rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.form-row .form-item {
  flex: 1;
}

.consumable-row .form-item {
  margin-bottom: 20rpx;
}

.material-card {
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #e8edf3;
  border-radius: 12rpx;
  background: #fbfcfe;
}

.material-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 16rpx;
  margin-bottom: 18rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.material-card-title {
  color: #333;
  font-size: 28rpx;
  font-weight: 700;
}

.material-delete {
  padding: 10rpx 18rpx;
  border-radius: 8rpx;
  background: #fff1f0;
  color: #e54d42;
  font-size: 24rpx;
  line-height: 1;
}

.add-material-btn {
  height: 84rpx;
  margin: 4rpx 0 24rpx;
  border: 2rpx dashed #2b7fd3;
  border-radius: 12rpx;
  background: #eef7ff;
  color: #1a6fc4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx;
  gap: 20rpx;
  border-top: 1rpx solid #eee;
}

.btn-cancel, .btn-submit {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-submit {
  background: linear-gradient(135deg, #1a6fc4 0%, #4a90e2 100%);
  color: #fff;
}

/* 删除确认弹窗 */
.delete-reason-modal .modal-content {
  width: 80%;
  border-radius: 24rpx;
}

.delete-reason-modal .modal-body {
  max-height: none;
  padding: 30rpx;
}

.delete-reason-textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  border: none;
}

.delete-reason-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}
