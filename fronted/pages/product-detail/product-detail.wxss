/* pages/product-detail/product-detail.wxss - 产品详情页（高级感重设计）
   风格与首页 index 完全统一
*/

/* ===== 页面根容器 ===== */
.page-pd {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fc 0%, #eef1f7 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

/* ===== Hero 轮播图区域 ===== */
.hero {
  position: relative;
  width: 100%;
  height: 520rpx;
  overflow: hidden;
  background: #1a1a2e;
  border-radius: 0 0 36rpx 36rpx;
}

.hero-swiper {
  width: 100%;
  height: 520rpx;
}

.hero-img {
  width: 100%;
  height: 520rpx;
  display: block;
}

/* 指示器 */
.hero-dots {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 10rpx;
  z-index: 10;
}

.hero-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.4);
  transition: all 0.3s ease;
}

.hero-dot.active {
  width: 28rpx;
  background: #ffffff;
}

/* 返回按钮 */
.hero-back {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 24rpx;
  z-index: 20;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  justify-content: center;
  align-items: center;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  transition: transform 0.2s ease;
}

.hero-back:active {
  transform: scale(0.9);
}

.hero-back-icon {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 600;
  line-height: 1;
}

/* 底部渐变 + 标签浮层 */
.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 32rpx 28rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
  z-index: 5;
}

/* 标签行 */
.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hero-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 500;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

/* 无图片兜底 */
.hero-fallback {
  width: 100%;
  height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8f8f8;
  border-radius: 0 0 36rpx 36rpx;
  gap: 16rpx;
}

.hero-fallback-icon {
  font-size: 80rpx;
  opacity: 0.35;
}

.hero-fallback-text {
  font-size: 28rpx;
  color: #8e92a4;
  font-weight: 500;
}

/* ===== 内容区 ===== */
.content {
  position: relative;
  z-index: 10;
  padding: 0 28rpx;
  margin-top: 0;
}

/* 首张卡片顶部圆角，与 Hero 衔接 */
.content > .card:first-child {
  border-radius: 28rpx 28rpx 28rpx 28rpx;
}

/* 首张卡片顶部圆角，与 Hero 衔接 */
.content > .card:first-child {
  border-radius: 28rpx 28rpx 28rpx 28rpx;
}

/* 通用卡片 */
.card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(26, 92, 240, 0.06);
  border: 1rpx solid rgba(26, 92, 240, 0.06);
  position: relative;
  overflow: hidden;
}

/* ===== 内容头部：名称+分类 ===== */
.content-header {
  margin-top: 0;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
}

.header-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.header-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(26, 92, 240, 0.08), rgba(74, 138, 255, 0.15));
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  box-shadow: 0 6rpx 20rpx rgba(26, 92, 240, 0.1);
}

.header-icon {
  width: 60rpx;
  height: 60rpx;
}

.header-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.header-name {
  font-size: 38rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.header-category {
  font-size: 24rpx;
  color: #8e92a4;
  font-weight: 500;
}

/* ===== 通用内容卡片标题行 ===== */
.card-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.card-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 8rpx currentColor;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: -0.3rpx;
}

.card-text {
  font-size: 28rpx;
  color: #4a5170;
  line-height: 1.85;
  font-weight: 400;
}

.detail-text {
  white-space: pre-line;
  line-height: 1.9;
}

/* ===== 核心优势 ===== */
.features-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, rgba(26, 92, 240, 0.03), rgba(74, 138, 255, 0.05));
  border-radius: 20rpx;
  border: 1rpx solid rgba(26, 92, 240, 0.06);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.feature-item:active {
  transform: translateX(4rpx);
  box-shadow: 0 4rpx 16rpx rgba(26, 92, 240, 0.08);
}

.feature-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, rgba(26, 92, 240, 0.12), rgba(74, 138, 255, 0.18));
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.feature-icon {
  font-size: 36rpx;
  line-height: 1;
}

.feature-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.feature-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: -0.2rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: #8e92a4;
  line-height: 1.6;
  font-weight: 400;
}

/* ===== 应用案例 ===== */
.cases-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.case-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8f9fc;
  border-radius: 18rpx;
  transition: background 0.2s ease;
}

.case-item:active {
  background: #eef1f7;
}

.case-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  object-fit: cover;
}

.case-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.case-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.case-desc {
  font-size: 24rpx;
  color: #8e92a4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.case-arrow {
  font-size: 36rpx;
  color: #c0c4d6;
  flex-shrink: 0;
  font-weight: 300;
}

/* ===== 底部留白 ===== */
.content-bottom-space {
  height: 120rpx;
}

/* ===== 底部联系栏 ===== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(26, 92, 240, 0.08);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-consult {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1a5cf0 0%, #4a8aff 100%);
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(26, 92, 240, 0.35);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  padding: 0;
}

.btn-consult:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(26, 92, 240, 0.25);
}

.btn-consult-icon {
  font-size: 36rpx;
}

.btn-consult-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}
