<!-- pages/mixing-tower-maintenance/mixing-tower-maintenance.wxml - 拌合楼保养表 -->
<view class="page-maintenance">

  <!-- 顶部标题 -->
  <view class="page-header">
    <text class="header-record-link" bindtap="goToRecord">查看记录 ></text>
  </view>

  <!-- ===== 表单区域 ===== -->
  <view class="form-section">

    <!-- 基础信息 -->
    <view class="section-card">
      <view class="section-title-bar">
        <text class="section-title">基本信息</text>
      </view>

      <!-- 所属站点 -->
      <view class="form-row">
        <text class="form-label required">所属站点</text>
        <picker mode="selector" range="{{stationOptions}}" range-key="name" bindchange="onStationChange">
          <view class="picker-val {{form.stationName ? '' : 'placeholder'}}">
            {{form.stationName || '请选择所属站点'}}
          </view>
        </picker>
      </view>
      <view class="form-line"></view>

      <!-- 拌合楼型号 -->
      <view class="form-row">
        <text class="form-label required">拌合楼型号</text>
        <input class="form-input" placeholder="请输入拌合楼型号" value="{{form.towerModel}}" bindinput="onInput" data-field="towerModel" adjust-position="{{true}}" />
      </view>
      <view class="form-line"></view>

      <!-- 保养日期 -->
      <view class="form-row">
        <text class="form-label required">保养日期</text>
        <picker mode="date" value="{{form.maintenanceDate}}" bindchange="onDateChange">
          <view class="picker-val {{form.maintenanceDate ? '' : 'placeholder'}}">
            {{form.maintenanceDate || '请选择日期'}}
          </view>
        </picker>
      </view>
      <view class="form-line"></view>

      <!-- 保养类型 -->
      <view class="form-row">
        <text class="form-label required">保养类型</text>
        <picker mode="selector" range="{{maintenanceTypeOptions}}" bindchange="onTypeChange">
          <view class="picker-val {{form.maintenanceTypeIndex >= 0 ? '' : 'placeholder'}}">
            {{form.maintenanceTypeIndex >= 0 ? maintenanceTypeOptions[form.maintenanceTypeIndex] : '请选择保养类型'}}
          </view>
        </picker>
      </view>
      <view class="form-line"></view>

      <!-- 保养负责人 -->
      <view class="form-row">
        <text class="form-label">保养负责人</text>
        <input class="form-input" placeholder="请输入负责人姓名" value="{{form.manager}}" bindinput="onInput" data-field="manager" adjust-position="{{true}}" />
      </view>
    </view>

    <!-- ===== 保养部位明细 ===== -->
    <view class="section-card">
      <view class="section-title-bar">
        <text class="section-title">保养部位明细</text>
      </view>

      <view class="item-list">
        <view class="item-card" wx:for="{{form.maintenanceItems}}" wx:key="index">
          <view class="item-header">
            <text class="item-title">保养部位 {{index + 1}}</text>
            <view class="delete-btn" bindtap="deleteMaintenanceItem" data-index="{{index}}">删除</view>
          </view>

          <!-- 保养部位 -->
          <view class="form-row">
            <text class="form-label">保养部位</text>
            <input class="form-input" placeholder="请输入保养部位" value="{{item.part}}" bindinput="onItemInput" data-index="{{index}}" data-field="part" adjust-position="{{true}}" />
          </view>
          <view class="form-line"></view>

          <!-- 保养内容 -->
          <view class="form-row-col">
            <text class="form-label">保养内容</text>
            <textarea class="form-textarea-small" placeholder="请输入保养内容" value="{{item.content}}" bindinput="onItemInput" data-index="{{index}}" data-field="content" adjust-position="{{true}}" />
          </view>
        </view>
      </view>

      <!-- 添加按钮 -->
      <view class="add-item-btn" bindtap="addMaintenanceItem">
        <text class="add-icon">+</text>
        <text class="add-text">添加保养部位</text>
      </view>
    </view>

    <!-- ===== 更换配件明细 ===== -->
    <view class="section-card">
      <view class="section-title-bar">
        <text class="section-title">更换配件明细</text>
      </view>

      <view class="item-list">
        <view class="item-card" wx:for="{{form.partsList}}" wx:key="index">
          <view class="item-header">
            <text class="item-title">配件 {{index + 1}}</text>
            <view class="delete-btn" bindtap="deletePart" data-index="{{index}}">删除</view>
          </view>

          <!-- 配件名称 -->
          <view class="form-row">
            <text class="form-label">配件名称</text>
            <input class="form-input" placeholder="请输入配件名称" value="{{item.name}}" bindinput="onPartInput" data-index="{{index}}" data-field="name" adjust-position="{{true}}" />
          </view>
          <view class="form-line"></view>

          <!-- 配件数量 -->
          <view class="form-row">
            <text class="form-label">配件数量</text>
            <input class="form-input" placeholder="请输入数量" value="{{item.quantity}}" bindinput="onPartInput" data-index="{{index}}" data-field="quantity" adjust-position="{{true}}" />
          </view>
        </view>
      </view>

      <!-- 添加按钮 -->
      <view class="add-item-btn" bindtap="addPart">
        <text class="add-icon">+</text>
        <text class="add-text">添加配件</text>
      </view>
    </view>

    <!-- ===== 现场照片 ===== -->
    <view class="section-card">
      <view class="section-title-bar">
        <text class="section-title">现场照片</text>
      </view>

      <view class="photo-list">
        <view class="photo-item" wx:for="{{form.photos}}" wx:key="*this">
          <image class="photo-img" src="{{item}}" mode="aspectFill" catchtap="previewPhoto" data-src="{{item}}" />
          <view class="photo-delete" bindtap="deletePhoto" data-index="{{index}}">×</view>
        </view>
        <view class="photo-add" bindtap="addPhoto" wx:if="{{form.photos.length < 9}}">
          <text class="photo-add-icon">+</text>
          <text class="photo-add-text">上传照片</text>
        </view>
      </view>
    </view>

    <!-- ===== 备注 ===== -->
    <view class="section-card">
      <view class="section-title-bar">
        <text class="section-title">备注</text>
      </view>
      <textarea class="form-textarea" placeholder="请输入备注信息（选填）..." value="{{form.remark}}" bindinput="onInput" data-field="remark" adjust-position="{{true}}" maxlength="500" />
    </view>

  </view>

  <!-- 提交按钮 -->
  <view class="btn-area">
    <view wx:if="{{!editMode}}" class="btn-draft" bindtap="saveDraft">暂存草稿</view>
    <view class="btn-submit" bindtap="submitForm">{{editMode ? '提交修改' : '提交记录'}}</view>
  </view>

  <view style="height: 60rpx;"></view>

  <view class="approval-selector" wx:if="{{approvalSelector.visible}}">
    <view class="selector-nav">
      <view class="selector-nav-btn" bindtap="closeApprovalSelector">‹</view>
      <view class="selector-title">{{approvalSelector.title}}</view>
      <view class="selector-nav-btn" bindtap="closeApprovalSelector">×</view>
    </view>
    <view class="selector-search">
      <text class="selector-search-icon">⌕</text>
      <input
        class="selector-search-input"
        placeholder="搜索"
        value="{{approvalSelector.keyword}}"
        bindinput="onApprovalSelectorSearch"
        confirm-type="search"
      />
    </view>
    <view class="selector-tab">用户</view>
    <scroll-view scroll-y class="selector-scroll">
      <view
        class="selector-user"
        wx:for="{{approvalSelector.filteredApprovers}}"
        wx:key="openid"
        bindtap="toggleApprovalSelectorUser"
        data-openid="{{item.openid}}"
      >
        <view class="selector-avatar">用户</view>
        <view class="selector-name">{{item.name}}</view>
        <view class="selector-check {{item.checked ? 'active' : ''}}">{{item.checked ? '✓' : ''}}</view>
      </view>
      <view class="selector-empty" wx:if="{{approvalSelector.filteredApprovers.length === 0}}">暂无可选用户</view>
    </scroll-view>
    <view class="selector-footer">
      <text class="selector-count">已选择 {{approvalSelector.selectedCount}} 人</text>
      <button class="selector-confirm" bindtap="confirmApprovalSelector">确定</button>
    </view>
  </view>
</view>
