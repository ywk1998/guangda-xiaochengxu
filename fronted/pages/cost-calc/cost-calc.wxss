/* pages/cost-calc/cost-calc.wxss */
.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 16rpx;
  color: #333;
}

.record-link {
  text-align: right;
  font-size: 26rpx;
  color: #1a6fc4;
  margin-bottom: 30rpx;
}

.form-group {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.picker {
  flex: 1;
  font-size: 28rpx;
  color: #999;
}

.picker.selected {
  color: #333;
}

.btn-submit {
  margin-top: 0;
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  flex: 2;
}

.btn-submit::after {
  border: none;
}

.btn-area {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 60rpx;
}

.btn-draft {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  border: 2rpx solid #1a6fc4;
  color: #1a6fc4;
  background: #fff;
}
