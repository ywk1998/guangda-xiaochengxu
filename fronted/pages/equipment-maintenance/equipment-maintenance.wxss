/* pages/equipment-maintenance/equipment-maintenance.wxss */

.page-maintenance {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #fff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.header-record-link {
  font-size: 28rpx;
  color: #1a6fc4;
}

/* 表单区域 */
.form-section {
  padding: 20rpx 24rpx;
}

.section-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
}

.section-title-bar {
  padding: 24rpx 0 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.form-row-col {
  padding: 16rpx 0 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  width: 220rpx;
  flex-shrink: 0;
}

.form-label.required::after {
  content: ' *';
  color: #e74c3c;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.form-row picker {
  flex: 1;
}

.form-line {
  height: 1rpx;
  background: #f0f0f0;
}

.picker-val {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

.picker-val.placeholder {
  color: #bbb;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  padding: 16rpx 0;
  box-sizing: border-box;
}

.form-textarea-small {
  width: 100%;
  min-height: 100rpx;
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
  box-sizing: border-box;
}

/* 明细列表 */
.item-list {
  padding: 16rpx 0;
}

.item-card {
  background: #fafafa;
  border-radius: 8rpx;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
}

.item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 12rpx;
  border-bottom: 1rpx dashed #eee;
}

.item-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #666;
}

.delete-btn {
  font-size: 26rpx;
  color: #e74c3c;
  padding: 4rpx 12rpx;
}

/* 添加按钮 */
.add-item-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-top: 1rpx dashed #eee;
  margin-top: 8rpx;
}

.add-icon {
  font-size: 32rpx;
  color: #1a6fc4;
  margin-right: 8rpx;
}

.add-text {
  font-size: 28rpx;
  color: #1a6fc4;
}

/* 照片 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 0;
  gap: 16rpx;
}

.photo-item {
  width: 200rpx;
  height: 200rpx;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 0 8rpx 0 8rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #ddd;
}

.photo-add-icon {
  font-size: 48rpx;
  color: #bbb;
}

.photo-add-text {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 8rpx;
}

/* 提交按钮 */
.btn-area {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
}

.btn-draft {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border: 1rpx solid #ddd;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #666;
}

.btn-submit {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #1a6fc4;
  border-radius: 44rpx;
  font-size: 30rpx;
  color: #fff;
}
