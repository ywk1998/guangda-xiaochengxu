/* pages/diesel-delivery/diesel-delivery.wxss - 加油车送油记录表 */

.page-delivery {
  min-height: 100vh;
  background: #f5f5f5;
}

/* ===== 顶部标题 ===== */
.page-header {
  background: #1a6fc4;
  padding: 40rpx 32rpx 32rpx;
  text-align: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  display: block;
}

.header-record-link {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  margin-top: 16rpx;
}

/* ===== 表单区域 ===== */
.form-section {
  background: #ffffff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 0 32rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.form-label {
  font-size: 30rpx;
  color: #333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
  padding: 0;
  background: transparent;
}

.form-value {
  font-size: 30rpx;
  color: #333;
}

.form-value.placeholder {
  color: #bbb;
}

.form-line {
  height: 1rpx;
  background: #f0f0f0;
}

.volume-wrap {
  display: flex;
  align-items: center;
}

.volume-input {
  width: 120rpx;
  text-align: right;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a6fc4;
}

.unit-text {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

/* ===== 设备列表 ===== */
.equipment-list {
  margin: 24rpx 0;
}

.equipment-card {
  background: #f8f9fc;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e8eaf0;
}

.equipment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8eaf0;
}

.equipment-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.delete-btn {
  font-size: 26rpx;
  color: #e74c3c;
  padding: 8rpx 20rpx;
  background: #fdeaea;
  border-radius: 6rpx;
}

.delete-btn:active {
  background: #fcd3d3;
}

.form-row-img {
  padding: 32rpx 0 24rpx;
}

/* ===== 图片上传 ===== */
.upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  border: 2rpx dashed #ddd;
}

.upload-btn {
  width: 180rpx;
  height: 140rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ddd;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #ffffff;
  flex-shrink: 0;
}

.upload-icon {
  font-size: 60rpx;
  color: #ccc;
  line-height: 1;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.reupload-tip {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.preview-img {
  width: 180rpx;
  height: 140rpx;
  border-radius: 12rpx;
}

.preview-item {
  position: relative;
  width: 180rpx;
  height: 140rpx;
  flex-shrink: 0;
}

.image-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.58);
  color: #fff;
  font-size: 26rpx;
}

/* ===== 添加设备按钮 ===== */
.add-equipment-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  margin-bottom: 24rpx;
  border: 2rpx dashed #1a6fc4;
  border-radius: 12rpx;
  background: #f0f7ff;
}

.add-icon {
  font-size: 36rpx;
  color: #1a6fc4;
  margin-right: 12rpx;
  font-weight: 600;
}

.add-text {
  font-size: 30rpx;
  color: #1a6fc4;
  font-weight: 500;
}

.add-equipment-btn:active {
  background: #e6f0fa;
}

/* ===== 备注 ===== */
.remark-area {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  color: #333;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* ===== 提交按钮 ===== */
.btn-area {
  display: flex;
  align-items: center;
  padding: 0 24rpx 0;
  gap: 20rpx;
}

.btn-draft {
  flex: 1;
  color: #1a6fc4;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 48rpx;
  border: 2rpx solid #1a6fc4;
  background: #ffffff;
}

.btn-draft:active {
  background: #f0f7ff;
}

.btn-submit {
  flex: 2;
  background: #1a6fc4;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 48rpx;
}

.btn-submit:active {
  background: #1557a8;
}
