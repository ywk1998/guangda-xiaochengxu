<!-- pages/approval-notifications/approval-notifications.wxml -->
<view class="page">
  <view class="stat-bar">
    <text class="stat-text">共 {{totalCount}} 条通知</text>
  </view>

  <scroll-view scroll-y class="notification-list">
    <block wx:for="{{notifications}}" wx:key="_id">
      <view class="notification-card">
        <view class="card-header">
          <text class="card-title">{{item.title || '审批通知'}}</text>
          <view class="status-tag {{item.statusClass}}">{{item.statusLabel}}</view>
        </view>
        <view class="notification-content">{{item.content || '审批状态已更新'}}</view>
        <view class="card-row card-row-time">
          <text class="row-label">通知时间</text>
          <text class="row-value time">{{item.timeText}}</text>
        </view>
      </view>
    </block>

    <view wx:if="{{!loading && notifications.length === 0}}" class="empty">
      <text>暂无审批通知</text>
    </view>
    <view wx:if="{{loading}}" class="loading-tip">加载中...</view>
  </scroll-view>
</view>
