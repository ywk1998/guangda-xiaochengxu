/* pages/approval-notifications/approval-notifications.wxss */
.page {
  min-height: 100vh;
  background: #f5f7fb;
}

.stat-bar {
  padding: 16rpx 24rpx;
  background: #fafafa;
}

.stat-text {
  font-size: 24rpx;
  color: #999;
}

.notification-list {
  box-sizing: border-box;
  height: calc(100vh - 88rpx);
  padding: 16rpx 24rpx;
}

.notification-card {
  box-sizing: border-box;
  max-width: 100%;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  flex: 1;
  min-width: 0;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-tag.approved {
  background: #e8f8f0;
  color: #27ae60;
}

.status-tag.pending {
  background: #fff7e6;
  color: #e67e22;
}

.status-tag.rejected {
  background: #fef0f0;
  color: #e74c3c;
}

.notification-content {
  color: #334155;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.card-row {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.card-row-time {
  padding-top: 14rpx;
  margin-top: 16rpx;
  border-top: 1rpx dashed #eee;
}

.row-label {
  width: 220rpx;
  flex-shrink: 0;
  color: #999;
  font-size: 26rpx;
}

.row-value {
  min-width: 0;
  flex: 1;
  color: #333;
  font-size: 28rpx;
  text-align: right;
  overflow-wrap: break-word;
  word-break: break-all;
}

.row-value.time {
  color: #bbb;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #ccc;
  font-size: 28rpx;
}

.loading-tip {
  text-align: center;
  padding: 30rpx 0;
  color: #ccc;
  font-size: 24rpx;
}
