/* pages/construction-log-summary/construction-log-summary.wxss */

/* ===== 顶部标题 ===== */
.page-header {
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  padding: 24rpx 32rpx;
  margin: -24rpx -24rpx 24rpx -24rpx;
  border-radius: 0;
}

.header-record-link {
  font-size: 28rpx;
  color: #1a6fc4;
}

.container {
  padding: 24rpx;
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 220rpx;
  box-sizing: border-box;
}

/* ===== 主表区域 ===== */
.main-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a6fc4;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e8eaf0;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #555;
  flex-shrink: 0;
}

.form-value {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* ===== 明细子表区域 ===== */
.sub-section {
  margin-bottom: 24rpx;
}

.sub-header {
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  border-bottom: 1rpx solid #e8eaf0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.sub-header-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a6fc4;
}

.btn-add-row {
  background: #1a6fc4;
  color: #fff;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1;
}

.btn-add-row::after {
  border: none;
}

/* ===== 子表卡片（纵向布局） ===== */
.sub-card {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f8f9fc;
  border-bottom: 1rpx solid #e8eaf0;
}

.card-index {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a6fc4;
}

.btn-del-row {
  color: #e74c3c;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  background: none;
  border: 1rpx solid #e74c3c;
  border-radius: 20rpx;
  line-height: 1;
}

.btn-del-row::after {
  border: none;
}

/* ===== 卡片内字段 ===== */
.card-field {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 20rpx;
}

.card-field:last-child {
  border-bottom: none;
}

.field-label {
  width: 220rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.field-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  padding: 0 32rpx 0 24rpx;
  font-size: 28rpx;
  color: #333;
  text-align: right;
}

/* ===== 盈亏颜色 ===== */
.profit { color: #27ae60; font-weight: 600; }
.loss   { color: #e74c3c; font-weight: 600; }

/* 盈亏输入框颜色 */
.profit-input.profit { color: #27ae60; }
.profit-input.loss { color: #e74c3c; }

/* ===== 空状态 ===== */
.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
  background: #fff;
  border-radius: 12rpx;
}

/* ===== 底部合计 ===== */
.footer-summary {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
}

.summary-row:last-child {
  border-bottom: none;
}

.summary-label {
  color: #666;
}

.summary-value {
  color: #333;
  font-weight: 600;
}

.summary-value.profit {
  color: #27ae60;
  font-weight: 700;
}

.summary-value.loss {
  color: #e74c3c;
  font-weight: 700;
}

/* ===== 底部按钮 ===== */
.btn-area {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  gap: 20rpx;
  box-sizing: border-box;
}

.btn-draft {
  flex: 1;
  color: #1a6fc4;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 48rpx;
  border: 2rpx solid #1a6fc4;
  background: #ffffff;
}

.btn-draft:active {
  background: #f0f7ff;
}

.btn-submit {
  flex: 2;
  background: #1a6fc4;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 48rpx;
}

.btn-submit:active {
  background: #1557a8;
}
